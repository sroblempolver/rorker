# Leave the Supabase values empty to run in local demo mode (data in web/.data, plan reader runs locally).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for storage uploads; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Plan reader key. Set it in the hosting settings, never in the repo or in chat.
# Without it, AutoCAD files are read from geometry only and PDFs/photos wait.
ANTHROPIC_API_KEY=

# Demo mode only: where the Python agent lives and which Python runs it.
RORKER_AGENT_DIR=../agent
RORKER_PYTHON=python3
