{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
